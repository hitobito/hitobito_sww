-# locals: (f:, attr:)

.row.mb-2
  .col-2.text-md-end= f.captionize(attr, Person)
  - %i[person_1 person_2].each do |key|
    .col-5
      = f.fields_for(key, include_id: false) do |fields|
        = yield fields
